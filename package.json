  "description": "The hyperlink connected every page on the web. Hyperlink connects every app: one MCP server in front of all your MCP servers, for any agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hyperlink": "dist/cli.js"
  },
  "main": "dist/index.js",
